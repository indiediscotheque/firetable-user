1.) make a copy of this file
2.) rename copy to config.js
3.) add your desired configs/creds

*/
var ftconfigs = {
   roomName: "Indie Discotheque's Basement", // what you'd like your room name to be displayed as
   roomNameShort: "Indie Discotheque", // if you have a long room name, put a shorter version here (like 2 words probably max).
   defaultAlbumArtUrl: "", // url of an image to use for tracks with no album art. should be a square and at least 500x500 px for best results.
   logoImage: "", // url of an image to use for logo
   facebookURL: "",
   soundcloudURL: "",
   redditURL: "",
   lastfmURL: "",
   discordURL: "",
   roomInfoUrl: "", // Change what the "?" button at the top of the page links to. This can be any URL
  avatarset: "", // Room-wide avatar theme that overrides everyone's avatar, all year.
                 // Leave empty to use avatarSeasons (monsters in October, normal robots otherwise).
                 // Robohash: "set1" robots, "set2" monsters, "set3" robot heads, "set4" cats
                 // (or any "dicebear:<style>", e.g. "dicebear:bottts").
  // avatarSeasons: [{ months: [10], style: "set2" }], // optional: replace the built-in seasonal themes (months 1-12), or false to turn them off
  // snowMonths: [1, 2], // optional: months (1-12) with subtle snowfall on the stage, or false to turn off
  // lightsMonths: [12], // optional: months (1-12) the stage string lights stay on by themselves, or false to turn off. Other months, supermods use !lights / !lightson / !lightsoff (indiediscotheque/firetable-hostbot only; set its LIGHTS_MONTHS to match).
   firebase:{ // put the info from your Firebase app here. can be found in the Firebase console
    apiKey: "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
    authDomain: "xxxxxxxxxxxxxxxxx.firebaseapp.com",
    databaseURL: "https://xxxxxxxxxxxxx.firebaseio.com"
  },
  // signInProviders: ["google", "apple"], // optional: show "Continue with Google / Apple" on the login screen.
  //   Turn each one on first in the Firebase console (Authentication > Sign-in method), and make sure
  //   this site's domain is listed under Authentication > Settings > Authorized domains.
  //   Apple also needs a Services ID and key from your Apple Developer account.
  youtubeKey: "xxxxxxxxxxxxxxxxxxxxxx", // Your youtube api client key. Be sure to whitelist your domain for this key in the google api console.
  // SoundCloud search runs through api/soundcloud.php, which keeps the
  // client secret on the server. See api/soundcloud-config.php.example.
  // soundcloudProxyURL: "https://example.com/api/soundcloud.php", // optional, only if the proxy lives on another host
  //                                                                  (then also add that host to connect-src in .htaccess)
  // Last.fm scrobbling runs through api/lastfm.php, which keeps the Last.fm
  // secret on the server. See api/lastfm-config.php.example.
  // lastfmProxyURL: "https://example.com/api/lastfm.php" // optional, only if the proxy lives on another host
