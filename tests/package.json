{
  "name": "firetable-user-tests",
  "private": true,
  "description": "Browser tests for the site, never deployed: unit tests of its own functions and of its analytics tag, a smoke test against a local database emulator, and its reads and writes against the hostbot's real database rules, all in Chromium under the real Content-Security-Policy from .htaccess.",
  "scripts": {
    "unit": "node --test unit.test.mjs analytics.test.mjs rail.test.mjs find.test.mjs",
    "smoke": "firebase emulators:exec --only database --project demo-smoke \"node smoke.mjs\"",
    "rules": "firebase emulators:exec --only database,auth --project demo-rules \"node rules.mjs\"",
    "screens": "firebase emulators:exec --only database,auth --project demo-screens \"node screens.mjs\"",
    "reach": "firebase emulators:exec --only database,auth --project demo-reach \"node reach.mjs\"",
    "a11y": "firebase emulators:exec --only database,auth --project demo-a11y \"node a11y.mjs\"",
    "avatars": "node avatars.mjs"
  },
  "devDependencies": {
    "axe-core": "4.14.0",
    "firebase-tools": "^15.34.2",
    "playwright": "1.63.0"
  }
}
