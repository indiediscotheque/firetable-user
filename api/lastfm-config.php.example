/*
 * Settings for api/lastfm.php (Last.fm scrobbling).
 *
 * 1.) copy this file to lastfm-config.php (same folder)
 * 2.) fill in your Last.fm API account's key and shared secret
 *     (https://www.last.fm/api/accounts)
 *
 * Or skip this file: set the LASTFM_API_KEY and LASTFM_SECRET repository
 * secrets on GitHub and the deploy writes lastfm-config.php for you.
 *
 * lastfm-config.php is git-ignored and only ever lives on the server. Env vars
 * LASTFM_API_KEY and LASTFM_SECRET work too and take priority.
 */
return [
    'api_key' => 'xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx',
    'secret'  => 'xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx',

    // Optional. Other sites allowed to use this proxy, e.g. when it lives on a
